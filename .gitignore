# Persönliche Pfade, Sprache, gemerkte Ansicht und die Bestätigung des
# Haftungshinweises. Gehört niemandem außer dem jeweiligen Benutzer und darf
# nicht ins Repository - sonst stehen fremde Benutzernamen und Laufwerke drin.
config.json

# Wird von Build-Deploy.ps1 erzeugt und lässt sich jederzeit neu bauen.
_deploy/

# Der Standard-Backup-Ordner liegt neben dem Programm. Da liegen echte
# Spielstände drin - die haben in einem Repository nichts verloren.
Backups/
D2R-Backups/

# Spielwiese von Test-Sandbox.ps1. Wird bei jedem Testlauf neu aufgebaut und
# bleibt danach zum Nachsehen stehen - reine Wegwerfdaten, nichts fürs Repo.
_sandbox/

# Von Render-Ansicht.ps1 erzeugte Bilder, falls sie hier landen.
ansicht*.png
hinweis*.png

# Windows
Thumbs.db
desktop.ini

# Quellstände früherer Versionen. Der Ordner ist am 06.08.2026 gelöscht worden,
# die Historie leistet dasselbe - die Zeile bleibt, damit ein versehentlich
# wieder angelegter Ordner nicht doch im Repository landet. Fertige Pakete
# gehören als GitHub-Release ans Tag, nicht als Datei in den Verlauf.
_versionen/
